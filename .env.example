# === Public (exposed to the browser) ===
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Temporary client-side admin password.
# Replaced by a server-validated gate in a later step.
VITE_ADMIN_PASSWORD=changeme

# === Server-only (Vercel functions) ===
SUPABASE_SERVICE_ROLE_KEY=

# Auth gates (bcrypt hashes — wired up in the auth step)
FAMILY_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=

# Session signing
JWT_SECRET=

# Gemini (voice-to-events)
GEMINI_API_KEY=

# Google OAuth (Calendar sync). Set redirect URI in the Google console to:
#   https://<your-vercel-domain>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
